{
  "extends": "./tsconfig.app.json",
  "include": [
    "env.d.ts",
    "components.d.ts",
    "auto-imports.d.ts",
    "src/**/*",
    "src/**/*.vue",
    "tests/unit/**/*.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.vitest.tsbuildinfo",
    "ignoreDeprecations": "6.0",
    "types": ["node", "vite/client"]
  }
}
