{
  "name": "tauri-app",
  "private": true,
  "version": "2.11.2",
  "type": "module",
  "scripts": {
    "dev": "cross-env DEBUG=0 vite",
    "test": "vitest",
    "test:node": "node --test tests/node/*.test.mjs",
    "lint": "eslint src tests --ext .ts,.vue",
    "format": "prettier --write src tests vite.config.ts vitest.config.ts eslint.config.cjs",
    "format:check": "prettier --check src tests vite.config.ts vitest.config.ts eslint.config.cjs",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --build --force",
    "audit:rust": "cargo audit -f src-tauri/Cargo.lock",
    "audit:web": "pnpm audit --prod",
    "verify": "pnpm lint && pnpm type-check && pnpm test --run && pnpm test:node && pnpm build && pnpm audit:rust && pnpm audit:web && cargo test --manifest-path src-tauri/Cargo.toml && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "release:windows": "powershell -ExecutionPolicy Bypass -File scripts/release-windows.ps1",
    "tauri": "tauri",
    "bump": "node bump-version.cjs",
    "check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "benchmark:tokens": "node scripts/benchmark-token-savings.mjs"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.2.0",
    "@hugeicons/vue": "^1.0.5",
    "@tauri-apps/api": "^2.11.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.30"
  },
  "devDependencies": {
    "@pinia/testing": "^1.0.3",
    "@tauri-apps/cli": "^2.11.2",
    "@tsconfig/node22": "^22.0.5",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^25.5.0",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/eslint-plugin": "^1.3.24",
    "@vue/devtools": "^8.1.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "esbuild": "^0.25.10",
    "eslint": "^10.4.1",
    "eslint-plugin-security": "^4.0.0",
    "eslint-plugin-vue": "^10.9.2",
    "jsdom": "^27.2.0",
    "lodash-es": "^4.17.23",
    "playwright": "^1.60.0",
    "prettier": "^3.8.1",
    "typescript": "^6.0.2",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.0.0",
    "vite": "^8.0.16",
    "vite-plugin-vue-devtools": "^8.1.1",
    "vitest": "^4.1.8",
    "vue-tsc": "^3.3.4"
  }
}
