+        changedModel = true
+        out[childKey] = model
+        continue
+      }
+      if (!changedPrompt && promptKeys.has(childKey.toLowerCase()) && typeof childValue === 'string') {
+        changedPrompt = true
+        out[childKey] = prompt
+        continue
+      }
